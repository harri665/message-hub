# Copy to .env for local runs, or set these in the Portainer stack's environment.

# Postgres password for the bundled database.
DB_PASSWORD=change-me

# Optional. Leave empty to create the sign-in password in the browser on first visit
# (the one-time setup code is printed in the hub's logs).
APP_PASSWORD=

# Shared secret between the hub and the WhatsApp connector (any long random string).
INTERNAL_SECRET=change-me

# Host port for the web app.
HUB_PORT=8095

# Set to true once the app is served over HTTPS (behind the reverse proxy).
SECURE_COOKIES=false

# Country code assumed for phone numbers without one, used to match people across iMessage and WhatsApp.
DEFAULT_COUNTRY_CODE=1

# Time zone for message times the MCP server shows to Claude (IANA name, e.g. America/Denver).
TIME_ZONE=UTC

# Optional. Names that mean you in search, so "from: harrison" finds the messages you sent (comma separated). "from: me" always works.
SELF_NAMES=

# Optional. BlueBubbles Server on the macOS VM (LAN address). Can instead be set in the web app's Settings.
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# Name shown under Linked devices in WhatsApp on the phone.
WA_DEVICE_NAME=Message Hub

# Optional. AI features (photo descriptions, search by meaning, search answers, reply suggestions) through Cloudflare
# Workers AI's free daily allowance. Create an API token with the "Workers AI: Read" and "Workers AI: Edit" permissions.
# Leave both empty to turn the AI features off. Photos and message text are sent to Cloudflare to be processed.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Neurons per day the hub may spend (Cloudflare's free allowance is 10000, reset at 00:00 UTC). Hubs that share one
# Cloudflare account share this allowance: each counts the whole account's use, so give their tokens the
# "Account Analytics: Read" permission too.
AI_DAILY_NEURONS=10000
# Name shown next to this hub's own Neuron count in Settings (defaults to the first SELF_NAMES entry).
HUB_OWNER=
# Optional model overrides (Workers AI model ids). Defaults: answers @cf/meta/llama-3.3-70b-instruct-fp8-fast,
# replies @cf/openai/gpt-oss-120b, photos and fallback @cf/google/gemma-4-26b-a4b-it.
AI_MODEL_ANSWER=
AI_MODEL_REPLY=
AI_MODEL_VISION=
AI_MODEL_FALLBACK=
