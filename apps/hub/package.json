{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "description": "Message Hub API: syncs iMessage (BlueBubbles) and WhatsApp into Postgres and serves the web app",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
